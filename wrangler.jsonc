{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resume",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "resume.huyab.click",
      "custom_domain": true
    }
  ]
}
